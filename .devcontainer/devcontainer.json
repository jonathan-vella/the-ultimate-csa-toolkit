{
  "name": "The Ultimate CSA Toolkit",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "init": true,
  "runArgs": [
    "--security-opt",
    "seccomp=${localWorkspaceFolder}/.devcontainer/chromium-seccomp.json"
  ],
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "username": "vscode",
      "upgradePackages": false
    }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "containerEnv": {
    "PYTHONDONTWRITEBYTECODE": "1",
    "PYTHONUNBUFFERED": "1",
    "UV_CACHE_DIR": "/home/vscode/.cache/uv"
  },
  "remoteEnv": {
    "AZURE_DEFAULTS_LOCATION": "swedencentral"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-azuretools.vscode-azureresourcegroups",
        "ms-azuretools.vscode-bicep",
        "ms-vscode.powershell",
        "ms-python.python",
        "ms-vscode.azurecli",
        "hashicorp.terraform",
        "yzhang.markdown-all-in-one",
        "bierner.markdown-mermaid",
        "bierner.markdown-preview-github-styles",
        "davidanson.vscode-markdownlint",
        "esbenp.prettier-vscode",
        "mhutchie.git-graph",
        "donjayamanne.githistory",
        "mechatroner.rainbow-csv",
        "redhat.vscode-yaml",
        "mutantdino.resourcemonitor",
        "github.vscode-github-actions",
        "github.vscode-pull-request-github",
        "ms-azuretools.vscode-azure-mcp-server"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "terminal.integrated.defaultProfile.linux": "bash",
        "files.eol": "\n",
        "python.analysis.typeCheckingMode": "basic",
        "python.defaultInterpreterPath": "/opt/csa-toolkit/.venv/bin/python",
        "mcp": {
          "servers": {
            "microsoft-learn": {
              "type": "http",
              "url": "https://learn.microsoft.com/api/mcp"
            }
          }
        }
      }
    }
  },
  "mounts": [
    {
      "source": "${localEnv:USERPROFILE}${localEnv:HOME}/.azure",
      "target": "/home/vscode/.azure",
      "type": "bind"
    },
    {
      "source": "devcontainer-gh-config-${devcontainerId}",
      "target": "/home/vscode/.config/gh",
      "type": "volume"
    },
    {
      "source": "devcontainer-uv-cache-${devcontainerId}",
      "target": "/home/vscode/.cache/uv",
      "type": "volume"
    }
  ],
  "remoteUser": "vscode"
}
